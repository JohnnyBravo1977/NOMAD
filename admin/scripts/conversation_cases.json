{
  "meta": {
    "description": "Conversation/personality regression cases for /api/ollama/chat. These assert safety invariants (no meta-leak, no fake prior convo, no generic closers) and minimal intent correctness.",
    "defaultModel": "qwen2.5:32b-instruct-q5_K_M"
  },
  "cases": [
    {
      "id": "status_check_basic",
      "turns": ["how are you quinn"],
      "expect": {
        "mustNotMatch": [
          "conversation segment",
          "\\bintent\\b",
          "\\bpayload\\b",
          "\\brouting\\b",
          "\\bschema\\b",
          "previous conversation",
          "don't hesitate",
          "let me know if",
          "anything else i can help",
          "is there anything else",
          "\\bshortcut\\b",
          "\\bdesktop\\b"
        ],
        "mustNotHaveEmoji": true
      }
    },
    {
      "id": "critique_flatness_just_ok",
      "turns": ["just ok"],
      "expect": {
        "mustNotMatch": [
          "\\bshortcut\\b",
          "\\bdesktop\\b",
          "conversation segment",
          "\\bintent\\b",
          "\\bpayload\\b",
          "\\brouting\\b",
          "\\bschema\\b"
        ],
        "mustNotHaveEmoji": true
      }
    },
    {
