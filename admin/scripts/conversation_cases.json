    {
      "id": "critique_flatness_after_shortcut_history",
      "seed": [
        { "role": "assistant", "content": "I created the Home Assistant shortcut on the Desktop." }
      ],
      "turns": ["just ok"],
      "expect": {
        "mustNotMatch": [
          "\\bi\\s+(?:created|removed|made|ran|executed|restarted|repaired|patched|inspected|checked|set|turned on|turned off|locked|unlocked)\\b[\\s\\S]{0,80}\\bshortcut\\b",
          "conversation segment",
          "\\bintent\\b",
          "\\bpayload\\b",
          "\\brouting\\b",
          "\\bschema\\b"
        ],
        "mustNotHaveEmoji": true
      }
    },
    {
      "id": "assistant_identity",
      "turns": ["whats your name"],
      "expect": {
        "mustMatch": ["\\bquinn\\b"],
        "mustNotMatch": ["conversation segment", "\\bintent\\b", "\\bpayload\\b", "previous conversation"],
        "mustNotHaveEmoji": true
      }
    },
    {
      "id": "reciprocal_status_no_robot_disclaimer",
      "turns": ["im fine and you?"],
      "expect": {
        "mustNotMatch": [
          "don't have feelings",
          "do not have feelings",
          "just a chat assistant",
          "just an ai assistant",
          "just a ai assistant"
        ],
        "mustNotHaveEmoji": true
      }
    },
